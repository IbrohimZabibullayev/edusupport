generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperatorStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

// So'rov turlari (admin panelda boshqariladi). key — Request.type da saqlanadigan barqaror kod.
model RequestType {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  emoji     String   @default("")
  color     String   @default("#2a78d6")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Module {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  emoji     String    @default("")
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  requests  Request[]
  supportLogs SupportLog[]
}

model System {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  groupChatId String?
  createdAt   DateTime     @default(now())
  requests    Request[]
  supportLogs SupportLog[]
}

// Support log prioriteti (admin panelda boshqariladi): P1/P2/P3 kabi
model Priority {
  id          Int          @id @default(autoincrement())
  key         String       @unique
  name        String
  color       String       @default("#eb6834")
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  supportLogs SupportLog[]
}

// Operator dasturchisiz o'zi hal qilgan muammolar jurnali (guruhga yuborilmaydi)
model SupportLog {
  id             Int       @id @default(autoincrement())
  logNumber      Int       @unique @default(autoincrement())
  systemId       Int?
  system         System?   @relation(fields: [systemId], references: [id])
  schoolId       Int
  school         School    @relation(fields: [schoolId], references: [id])
  moduleId       Int
  module         Module    @relation(fields: [moduleId], references: [id])
  problem        String
  priorityId     Int?
  priority       Priority? @relation(fields: [priorityId], references: [id])
  resolveMinutes Int       @default(0)
  recurring      Boolean   @default(false)
  operatorId     Int
  operator       Operator  @relation(fields: [operatorId], references: [id])
  createdAt      DateTime  @default(now())

  @@index([createdAt])
  @@index([moduleId])
}

model Operator {
  id         Int            @id @default(autoincrement())
  telegramId String         @unique
  fullName   String
  phone      String?
  username   String?
  status     OperatorStatus @default(PENDING)
  isAdmin    Boolean        @default(false)
  createdAt  DateTime       @default(now())
  requests   Request[]
  schools    School[]       @relation("SchoolCreator")
  supportLogs SupportLog[]
}

model School {
  id                  Int       @id @default(autoincrement())
  name                String    @unique
  createdByOperatorId Int?
  createdBy           Operator? @relation("SchoolCreator", fields: [createdByOperatorId], references: [id])
  createdAt           DateTime  @default(now())
  requests            Request[]
  supportLogs         SupportLog[]
}

model Request {
  id           Int         @id @default(autoincrement())
  ticketNumber Int         @unique @default(autoincrement())
  type         String
  systemId     Int?
  system       System?     @relation(fields: [systemId], references: [id])
  moduleId     Int
  module       Module      @relation(fields: [moduleId], references: [id])
  schoolId     Int
  school       School      @relation(fields: [schoolId], references: [id])
  operatorId   Int
  operator     Operator    @relation(fields: [operatorId], references: [id])
  description  String
  done         Boolean     @default(false)
  doneAt       DateTime?
  cardChatId   String?
  cardMessageId Int?
  createdAt    DateTime    @default(now())
  attachments  RequestAttachment[]

  @@index([createdAt])
  @@index([type])
  @@index([moduleId])
}

model RequestAttachment {
  id        Int      @id @default(autoincrement())
  requestId Int
  request   Request  @relation(fields: [requestId], references: [id])
  kind      String
  fileId    String
  caption   String?
  createdAt DateTime @default(now())

  @@index([requestId])
}

// Bo'lim nomini so'rov turiga bog'laydigan kalit so'z (admin panelda tahrirlanadi).
// Bo'lim nomida shu so'z bo'lsa (kichik harf, qism-satr), o'sha tur avto-biriktiriladi.
model TopicKeyword {
  id        Int      @id @default(autoincrement())
  type      String
  keyword   String
  createdAt DateTime @default(now())

  @@unique([type, keyword])
}

// Forum guruh bo'limi: qaysi guruhda qaysi so'rov turi qaysi bo'limga (topic) tushishi.
// auto=true — bot bo'lim nomidan o'zi aniqlagan; auto=false — admin /settopic bilan qo'lda biriktirgan
model GroupTopic {
  id        Int      @id @default(autoincrement())
  chatId    String
  type      String
  threadId  Int
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([chatId, type])
}

model BotSession {
  key   String @id
  value String
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
