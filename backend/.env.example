# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=

# PostgreSQL ulanishi
DATABASE_URL=postgresql://user:parol@localhost:5432/edusupport

# Admin panelga kirish
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
JWT_SECRET=

# Dasturchilar guruhi. Odatda guruh ichida /setgroup yozib belgilanadi —
# bu yerdagi qiymat faqat zaxira.
DEV_GROUP_ID=
# Takliflar (SUGGESTION) alohida chatga tushishi kerak bo'lsa
BACKLOG_CHAT_ID=

PORT=3000


# ─────────────────────────────────────────────────────────────
# Assistent rejimi (AI)
#
# Ikkalasi ham bo'sh bo'lsa bot eski tugmali rejimda ishlayveradi.
# Ikkalasi ham berilsa Google ustun turadi.
# ─────────────────────────────────────────────────────────────

# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Modelni majburan belgilash. Bo'sh qoldirilsa:
#   Google    → gemini-2.5-flash
#   Anthropic → claude-sonnet-5
# Kalitingizga qaysi modellar ochiqligini ko'rish uchun: npm run models
AI_MODEL=
